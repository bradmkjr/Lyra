<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
	     Keys without an INFOPLIST_KEY_* build setting live here. -->
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>Lyra.sdef</string>
	<!-- Pandora's audio-*.pandora.com stream hosts are HTTP-only. Allow plain HTTP for
	     AVFoundation media loads only; URLSession (API, artwork) stays HTTPS-only. -->
	<!-- Lyra finds AirPlay receivers on the local network and streams to them itself. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_raop._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lyra finds AirPlay speakers and Apple TVs on your network so it can play music in other rooms.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lyra listens for short chirps from each room's speakers to line up multi-room playback. Audio is only analyzed during calibration and never saved.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
</dict>
</plist>
